{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "package.json",
      "package-lock.json",
      "CLAUDE.md",
      "FUTURE_PLANS.md",
      "README.md",
      "**/node_modules/**",
      "**/.git/**",
      "**/.github/**",
      "**/android/**",
      "**/hooks/**",
      "**/.qoder/**",
      "**/.firebase/**",
      "**/test/**",
      "**/www/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
